{
	"id": "remote",
	"name": "Remote",
	"description": "Launch and manage instances from a remote computer",
	"documentation": "https://nitrolaunch.github.io/nitrolaunch/plugins/plugins/remote",
	"version": "0.32.1",
	"nitro_version": "0.32.1",
	"protocol_version": 3,
	"hooks": {
		"add_instances": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"add_templates": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"replace_instance_launch": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"replace_instance_update": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"save_instance_config": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"save_template_config": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"delete_instance": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"kill_instance": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"subcommand": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_remote"
		},
		"add_plugin_config_controls": {
			"constant": [
				{
					"id": "remote",
					"name": "Remote",
					"schema": {
						"type": "section"
					}
				},
				{
					"id": "remotes",
					"name": "Remotes",
					"description": "Remote control servers to connect to",
					"section": "Remote",
					"schema": {
						"type": "list",
						"fields": [
							{
								"id": "id",
								"name": "ID",
								"description": "The ID to use for the remote server. Impacts instance and template IDs.",
								"schema": {
									"type": "string"
								}
							},
							{
								"id": "address",
								"name": "Address",
								"description": "The address of the remote server, without protocol or port",
								"schema": {
									"type": "string"
								}
							},
							{
								"id": "key",
								"name": "Key",
								"description": "The key to use for authentication with the remote server",
								"schema": {
									"type": "string"
								}
							}
						]
					}
				}
			]
		}
	},
	"subcommands": {
		"remote": "Manage remote instance access",
		"rem": "Manage remote instance access"
	}
}