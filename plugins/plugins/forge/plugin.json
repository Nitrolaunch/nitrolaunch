{
	"id": "forge",
	"name": "Forge",
	"description": "Install NeoForge instances",
	"documentation": "https://nitrolaunch.github.io/nitrolaunch/plugins/plugins/forge",
	"uninstall_dirs": ["forge"],
	"version": "0.32.1",
	"nitro_version": "0.32.1",
	"protocol_version": 3,
	"hooks": {
		"on_instance_setup": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_forge${EXE_EXTENSION}"
		},
		"add_supported_loaders": {
			"constant": [
				"neoforged"
			]
		}
	}
}