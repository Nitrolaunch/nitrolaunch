{
	"id": "discord_status",
	"name": "Discord Status",
	"description": "Show your running instances to Discord",
	"version": "v8",
	"nitro_version": "0.31.0",
	"protocol_version": 3,
	"hooks": {
		"while_instance_launch": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_discord_status${EXE_EXTENSION}"
		},
		"on_instance_stop": {
			"executable": "${PLUGIN_DIR}/nitro_plugin_discord_status${EXE_EXTENSION}"
		}
	}
}