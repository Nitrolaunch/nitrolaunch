{
	"id": "share",
	"name": "Share",
	"description": "Share templates and addons with friends",
	"documentation": "https://nitrolaunch.github.io/nitrolaunch/plugins/plugins/share",
	"version": "v7",
	"nitro_version": "0.30.0",
	"protocol_version": 3,
	"hooks": {
		"subcommand": {
			"wasm": true
		},
		"add_dropdown_buttons": {
			"constant": [
				{
					"plugin": "share",
					"location": "add_template_or_instance",
					"icon": "download",
					"text": "Template from Code",
					"tip": "Import a template from a code",
					"popup": "import_template"
				},
				{
					"plugin": "share",
					"location": "template_more_options",
					"icon": "popout",
					"text": "Share",
					"tip": "Export this template as a code to share with friends",
					"popup": "export_template"
				}
			]
		},
		"inject_page_script": {
			"property": "page",
			"cases": {
				"\"instances\"": {
					"file": "export_template.js"
				}
			}
		},
		"get_popup": {
			"wasm": true
		},
		"custom_action": {
			"wasm": true
		}
	},
	"subcommands": {
		"share-addons": {
			"supercommand": "instance",
			"description": "Share addons as a zip file"
		},
		"share": {
			"supercommand": "template",
			"description": "Share a template with a code"
		},
		"use": {
			"supercommand": "template",
			"description": "Download a template from a code"
		}
	}
}