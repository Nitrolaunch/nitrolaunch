{
	"id": "themes",
	"name": "Themes",
	"description": "Adds more themes for you to choose from",
	"version": "v8",
	"nitro_version": "0.31.0",
	"hooks": {
		"add_themes": {
			"constant": [
				{
					"id": "ghost",
					"name": "Ghost",
					"description": "White accent colors",
					"type": "overlay",
					"settings": "$file:ghost.json",
					"color": "#ffffff"
				},
				{
					"id": "catppuccin",
					"name": "Catppuccin (Mocha)",
					"description": "Soft mocha color scheme",
					"type": "base",
					"settings": "$file:catppuccin.json",
					"color": "#f5c2e7"
				},
				{
					"id": "sunset",
					"name": "Sunset (Dark Red)",
					"description": "Warm sunset-inspired dark reds and oranges",
					"type": "base",
					"settings": "$file:sunset.json",
					"color": "#ff6b6b"
				},
				{
					"id": "matcha",
					"name": "Matcha",
					"description": "Soft dark green theme",
					"type": "base",
					"settings": "$file:matcha.json",
					"color": "#8fbc8f"
				},
				{
					"id": "nord",
					"name": "Nord",
					"description": "Arctic-inspired blue-gray palette",
					"type": "base",
					"settings": "$file:nord.json",
					"color": "#88c0d0"
				},
				{
					"id": "high_contrast",
					"name": "High Contrast",
					"description": "Pure black and white accessibility-focused theme",
					"type": "base",
					"settings": "$file:high_contrast.json",
					"color": "#ffffff"
				}
			]
		}
	}
}