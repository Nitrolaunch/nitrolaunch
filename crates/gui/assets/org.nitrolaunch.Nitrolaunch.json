{
  "app-id": "org.nitrolaunch.Nitrolaunch",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "nitro_gui",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=x11",
    "--socket=wayland",
    "--socket=session-bus",
    "--socket=system-bus",
    "--socket=pulseaudio",
    "--socket=pcsc",
    "--device=dri",
    "--device=all",
    "--filesystem=home:rw",
    "--filesystem=/tmp:rw",
    "--filesystem=/var/tmp:rw",
    "--filesystem=xdg-data:rw",
    "--filesystem=xdg-config:rw",
    "--filesystem=xdg-cache:rw",
    "--persist=.config/nitrolaunch",
    "--persist=.local/share/nitrolaunch",
    "--talk-name=org.freedesktop.portal.*",
    "--talk-name=org.freedesktop.secrets",
    "--env=HOME=/home/user"
  ],
  "modules": [
    {
      "name": "nitro_gui",
      "buildsystem": "simple",
      "build-commands": [
        "BIN=$(find target -type f -name nitro_gui 2>/dev/null | head -n 1); if [ -z \"$BIN\" ]; then echo 'nitro_gui binary not found in target/ (tried release/fast_release/debug)'; exit 1; fi; install -Dm755 \"$BIN\" /app/bin/nitro_gui",
        "install -Dm644 crates/gui/assets/Nitrolaunch.desktop /app/share/applications/org.nitrolaunch.Nitrolaunch.desktop",
        "install -Dm644 crates/gui/assets/icon_1024x1024.png /app/share/icons/hicolor/1024x1024/apps/org.nitrolaunch.Nitrolaunch.png",
        "install -Dm644 crates/gui/assets/icon_1024x1024.png /app/share/icons/hicolor/128x128/apps/org.nitrolaunch.Nitrolaunch.png",
        "install -Dm644 crates/gui/assets/icon_1024x1024.png /app/share/icons/hicolor/256x256/apps/org.nitrolaunch.Nitrolaunch.png"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../.."
        }
      ]
    }
  ]
}
